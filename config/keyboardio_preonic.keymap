#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// layers

#define L_DV 0
#define L_LW 1
#define L_RZ 2
#define L_GA 3
#define L_GL 4
#define L_GR 5
#define L_MS 6
#define L_MD 7
#define L_SY 8

// convenience macros

#define KP_DIV KP_DIVIDE
#define KP_MLT KP_MULTIPLY
#define KP_MIN KP_MINUS
#define KP_RET KP_ENTER

#define LT_LW &lt L_LW
#define LT_RZ &lt L_RZ
#define LT_MS &lt L_MS
#define LT_MD &lt L_MD
#define LT_SY &lt L_SY

#define HLG &hml LGUI
#define HLA &hml LALT
#define HLT &hml RALT
#define HLS &hml LSHIFT
#define HLC &hml LCTRL
#define HRG &hml RGUI
#define HRA &hml RALT
#define HRT &hml LALT
#define HRS &hml RSHIFT
#define HRC &hml RCTRL

#define MTLG &mt LGUI
#define MTLA &mt LALT
#define MTLS &mt LSHIFT
#define MTLC &mt LCTRL
#define MTRG &mt RGUI
#define MTRA &mt RALT
#define MTRS &mt RSHIFT
#define MTRC &mt RCTRL

// behaviour configuration

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick_tap_ms = <200>; };

#define BT(n) BT_SEL n

/ {
    chosen {
        // Valid choices: [ &mit_layout, &ortho_layout ]
        zmk,physical-layout = &mit_layout;
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < 1 >;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < 1 >;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "base";
            bindings = <
                                                                                                             &kp C_PP    &kp C_NEXT  &kp C_MUTE
 &kp F1     &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9       &kp F10     &kp F11     &kp F12
 MTLG ESC   &kp APOS    HLT COMMA   &kp PERIOD  &kp P       &kp Y       &kp F       &kp G       &kp C        &kp R       &kp L       MTRG TAB
 MTLC BSPC  HLG A       HLA O       HLS E       HLC U       &kp I       &kp D       &kp H       &kp T        &kp N       &kp S       MTRC DEL
 MTLS TAB   &kp SEMI    &kp Q       &kp J       &kp K       &kp X       &kp B       &kp M       &kp W        &kp V       &kp Z       MTRS ENTER
 &kp HYPER  &kp LCTRL   MTLG LALT   MTLA LGUI   LT_LW LBKT        LT_MS SPACE       LT_RZ RBKT  MTRA LEFT    MTRG DOWN   &kp UP      &kp RIGHT >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            label = "lower";
            bindings = <
                                                                                                             &trans      &trans      &trans
 &trans     &trans      &trans      &trans      &trans      &trans      &trans      &trans      &kp KP_DIV   &kp KP_MLTY &kp KP_MIN  &kp KP_EQUAL
 &trans     &trans      &trans      &trans      &trans      &trans      &trans      &kp KP_N7   &kp KP_N8    &kp KP_N9   &kp KP_MIN  &trans
 &trans     &trans      &trans      &trans      &trans      &trans      &trans      &kp KP_N4   &kp KP_N5    &kp KP_N6   &kp KP_PLUS &trans
 &trans     &trans      &trans      &trans      &trans      &trans      &trans      &kp KP_N1   &kp KP_N2    &kp KP_N3   &kp KP_PLUS &trans
 &trans     &trans      &trans      &trans      &trans            &trans            &kp KP_N0   &kp KP_DOT   &trans      &kp KP_RET  &trans >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        raise_layer {
            label = "raise";
            bindings = <
                                                                                                             &trans      &trans     &trans
 &trans     &trans      &trans      &trans      &trans      &trans      &trans      &trans       &trans      &trans      &trans     &trans
 &trans     &trans      &trans      &trans      &trans      &trans      &trans      &trans       &trans      &trans      &trans     &trans
 &kp CAPS   &trans      &trans      &trans      &trans      &trans      &kp LEFT    &kp DOWN     &kp UP      &kp RIGHT   &trans     &trans
 &trans     &trans      &trans      &trans      &trans      &trans      &trans      &trans       &trans      &trans      &trans     &trans
 &trans     &trans      &kp RALT    &trans      &trans            &trans            &trans       &trans      &trans      &trans     &trans >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        game_layer {
            label = "game";
            bindings = <
                                                                                                             &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans           &trans             &trans      &trans      &trans      &trans      &trans >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        game_lower_layer {
            label = "game lower";
            bindings = <
                                                                                                             &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans           &trans             &trans      &trans      &trans      &trans      &trans >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        game_raise_layer {
            label = "game raise";
            bindings = <
                                                                                                             &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans           &trans             &trans      &trans      &trans      &trans      &trans >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        mouse_layer {
            label = "mouse";
            bindings = <
                                                                                                             &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans           &trans             &trans      &trans      &trans      &trans      &trans >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        media_layer {
            label = "media";
            bindings = <
                                                                                                             &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans           &trans             &trans      &trans      &trans      &trans      &trans >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        system_layer {
            label = "system";
            bindings = <
                                                                                                             &trans      &trans      &trans
 &out OUT_TOG &bt BT(0)  &bt BT(1)   &bt BT(2)   &bt BT(3)   &bt BT(4)   &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &bootloader &trans      &trans      &trans      &studio_unlock   &trans             &trans      &trans      &trans      &trans      &bt BT_CLR >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        /* template
                                                                                                             &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &trans      &trans      &trans           &trans             &trans      &trans      &trans      &trans      &trans >;
         */
    };
};
